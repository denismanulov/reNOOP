    "Charge out of date, last synced %@. Open reNOOP on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladung veraltet, zuletzt synchronisiert %@. Öffne reNOOP auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery out of date, last synced %@. Open reNOOP on iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga desatualizada, última sincronização %@. Abra o reNOOP no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление устарело, последняя синхронизация %@. Откройте reNOOP на iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga fuera de la fecha, última sincronizada %1$@. Abrir reNOOP en iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge hors date, dernière synchronisation %1$@. Ouvrez reNOOP sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica non aggiornata, ultima sincronizzazione %@. Apri reNOOP su iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energia nieaktualny, ostatnia synchronizacja %@. Otwórz reNOOP na iPhonie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量数据已过期，上次同步 %@。请在 iPhone 上打开 reNOOP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能量資料已過期，上次同步 %@。請在 iPhone 上開啟 reNOOP。"
          }
        }
      }
    },
