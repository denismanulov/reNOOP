    "reNOOP. No data yet, open reNOOP on your iPhone to sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Noch keine Daten, öffne reNOOP auf deinem iPhone zum Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. No data yet, open reNOOP on your iPhone to sync."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Ainda não há dados, abra o reNOOP no teu iPhone para tincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Данных пока нет, откройте reNOOP на iPhone для синхронизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Aún no hay datos, abra reNOOP en su iPhone para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Pas encore de données, ouvrez reNOOP sur votre iPhone pour synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Ancora nessun dato, apri reNOOP sul tuo iPhone per sincronizzare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Nie ma jeszcze danych. Otwórz reNOOP na swoim iPhonie, aby przeprowadzić synchronizację."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reNOOP。暂无数据，请在 iPhone 上打开 reNOOP 进行同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reNOOP。暫無資料，請在 iPhone 上開啟 reNOOP 進行同步。"
          }
        }
      }
    },
    "reNOOP. Scores out of date, last synced %@. Open reNOOP on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Werte veraltet, zuletzt synchronisiert %@. Öffne reNOOP auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Scores out of date, last synced %@. Open reNOOP on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o reNOOP no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Показатели устарели, последняя синхронизация %@. Откройте reNOOP на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Resultados fuera de la fecha, último sincronizado %1$@. Abra reNOOP en iPhone para refrescarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez reNOOP sur iPhone pour vous rafraîchir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Punteggi non aggiornati, ultima sincronizzazione %@. Apri reNOOP su iPhone per aggiornare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "reNOOP. Wyniki nieaktualne, ostatnia synchronizacja %@. Otwórz reNOOP na iPhonie, aby odświeżyć."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reNOOP。评分已过期，上次同步 %@。请在 iPhone 上打开 reNOOP 以刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reNOOP。評分已過期，上次同步 %@。請在 iPhone 上開啟 reNOOP 以重新整理。"
          }
        }
      }
    },
