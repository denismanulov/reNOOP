{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP"}}}},
    "NSAlarmKitUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP sets a system alarm as the phone’s backup to your strap’s silent wake."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP ставит системный будильник как запасной к беззвучной вибрации браслета."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP stellt einen Systemwecker als Backup des iPhone für den stillen Weckalarm deines Armbands."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP configura una alarma del sistema como respaldo del iPhone para la alarma silenciosa de tu pulsera."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP programme une alarme système en secours de l'alarme silencieuse de votre bracelet."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP imposta una sveglia di sistema come riserva della sveglia silenziosa della fascia."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP ustawia budzik systemowy jako zapasowy dla cichej pobudki opaski."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP define um alarme do sistema como reserva do iPhone para o despertar silencioso da pulseira."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 会设置系统闹钟，作为手环静音唤醒的 iPhone 备用闹钟。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 會設定系統鬧鐘，作為手環靜音喚醒的 iPhone 備用鬧鐘。"}}}},
    "NSBluetoothAlwaysUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP connects to your WHOOP strap to read heart rate, HRV and battery on this iPhone."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP подключается к браслету WHOOP, чтобы считывать пульс, ВСР и заряд батареи на этом iPhone."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP verbindet sich mit deinem WHOOP-Armband, um Herzfrequenz, HFV und Batteriestand auf diesem iPhone zu lesen."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP se conecta a tu pulsera WHOOP para leer la frecuencia cardiaca, la VFC y la batería en este iPhone."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP se connecte à votre bracelet WHOOP pour lire la fréquence cardiaque, la VFC et la batterie sur cet iPhone."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP si collega alla fascia WHOOP per leggere frequenza cardiaca, HRV e batteria su questo iPhone."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP łączy się z opaską WHOOP, aby odczytywać tętno, HRV i poziom baterii na tym iPhonie."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP liga-se à pulseira WHOOP para ler a frequência cardíaca, a VFC e a bateria neste iPhone."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 连接你的 WHOOP 手环，以在此 iPhone 上读取心率、心率变异性和电池电量。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 連接你的 WHOOP 手環，以在此 iPhone 上讀取心率、心率變異性和電池電量。"}}}},
    "NSHealthShareUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP reads your Apple Health data to compute Recovery, Strain and sleep on this iPhone."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP читает данные приложения «Здоровье», чтобы рассчитывать Восстановление, Нагрузку и сон на этом iPhone."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP liest deine Daten aus Apple Health, um Ladung, Belastung und Schlaf auf diesem iPhone zu berechnen."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP lee tus datos de Apple Salud para calcular la carga, el esfuerzo y el sueño en este iPhone."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP lit vos données Apple Santé pour calculer la charge, l'effort et le sommeil sur cet iPhone."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP legge i dati di Apple Salute per calcolare carica, sforzo e sonno su questo iPhone."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP odczytuje dane z aplikacji Zdrowie, aby obliczać naładowanie, wysiłek i sen na tym iPhonie."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP lê os dados da app Saúde para calcular a carga, o esforço e o sono neste iPhone."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 读取你的 Apple“健康”数据，以在此 iPhone 上计算电量、强度和睡眠。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 讀取你的 Apple「健康」資料，以在此 iPhone 上計算電量、強度和睡眠。"}}}},
    "NSHealthUpdateUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP saves the metrics it computes from your strap to Apple Health."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP сохраняет показатели, рассчитанные по данным браслета, в приложение «Здоровье»."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP speichert die aus deinem Armband berechneten Werte in Apple Health."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP guarda en Apple Salud las métricas que calcula a partir de tu pulsera."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP enregistre dans Apple Santé les mesures calculées à partir de votre bracelet."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP salva in Apple Salute i valori calcolati dalla fascia."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP zapisuje w aplikacji Zdrowie parametry obliczone na podstawie danych z opaski."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP guarda na app Saúde as métricas que calcula a partir da pulseira."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 会将根据手环计算出的指标存储到 Apple“健康”。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 會將根據手環計算出的指標儲存到 Apple「健康」。"}}}},
    "NSLocationWhenInUseUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP records your route during outdoor workouts, also with the screen off, to show distance, pace and a map."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP записывает маршрут на тренировках на улице, в том числе при выключенном экране, чтобы показать дистанцию, темп и карту."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP zeichnet deine Route bei Trainings im Freien auf, auch bei ausgeschaltetem Bildschirm, um Distanz, Tempo und eine Karte anzuzeigen."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP registra tu ruta en los entrenamientos al aire libre, también con la pantalla apagada, para mostrar la distancia, el ritmo y un mapa."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP enregistre votre itinéraire pendant les entraînements en extérieur, même écran éteint, pour afficher la distance, l'allure et un plan."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP registra il percorso durante gli allenamenti all'aperto, anche a schermo spento, per mostrare distanza, passo e mappa."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP zapisuje trasę podczas treningów na zewnątrz, także przy wyłączonym ekranie, aby pokazać dystans, tempo i mapę."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP regista o percurso nos treinos ao ar livre, mesmo com o ecrã desligado, para mostrar a distância, o ritmo e um mapa."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 会在户外体能训练期间记录你的路线（包括屏幕关闭时），以显示距离、配速和地图。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 會在戶外體能訓練期間記錄你的路線（包括螢幕關閉時），以顯示距離、配速和地圖。"}}}},
    "NSMicrophoneUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP uses the microphone so you can ask the coach a question by voice."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP использует микрофон, чтобы вопрос тренеру можно было задать голосом."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP verwendet das Mikrofon, damit du dem Coach eine Frage per Sprache stellen kannst."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP usa el micrófono para que puedas hacer una pregunta al entrenador con la voz."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP utilise le micro pour que vous puissiez poser une question au coach à voix haute."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP usa il microfono per consentirti di fare una domanda al coach con la voce."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP używa mikrofonu, aby można było zadać pytanie trenerowi głosem."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP usa o microfone para que possa fazer uma pergunta ao treinador por voz."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 使用麦克风，以便你用语音向教练提问。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 使用麥克風，以便你用語音向教練提問。"}}}},
    "NSMotionUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP reads your iPhone’s step count to show steps for walking and running workouts."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP считывает шаги iPhone, чтобы показывать их на тренировках ходьбой и бегом."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP liest die Schrittzahl deines iPhone, um Schritte bei Geh- und Lauftrainings anzuzeigen."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP lee el recuento de pasos del iPhone para mostrar los pasos en los entrenamientos de caminata y carrera."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP lit le nombre de pas de votre iPhone pour les afficher lors des entraînements de marche et de course."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP legge il conteggio dei passi dell'iPhone per mostrarli negli allenamenti di camminata e corsa."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP odczytuje liczbę kroków z iPhone’a, aby pokazywać je podczas treningów chodu i biegu."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP lê a contagem de passos do iPhone para mostrar os passos nos treinos de caminhada e corrida."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 读取 iPhone 的步数，以在步行和跑步体能训练中显示步数。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 讀取 iPhone 的步數，以在步行和跑步體能訓練中顯示步數。"}}}},
    "NSSpeechRecognitionUsageDescription" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "reNOOP transcribes your question on this iPhone so you can ask the coach out loud."}}, "ru": {"stringUnit": {"state": "translated", "value": "reNOOP распознаёт вопрос на этом iPhone, чтобы его можно было задать тренеру голосом."}}, "de": {"stringUnit": {"state": "translated", "value": "reNOOP transkribiert deine Frage auf diesem iPhone, damit du den Coach laut fragen kannst."}}, "es": {"stringUnit": {"state": "translated", "value": "reNOOP transcribe tu pregunta en este iPhone para que puedas hacérsela al entrenador en voz alta."}}, "fr": {"stringUnit": {"state": "translated", "value": "reNOOP transcrit votre question sur cet iPhone pour que vous puissiez la poser au coach à voix haute."}}, "it": {"stringUnit": {"state": "translated", "value": "reNOOP trascrive la tua domanda su questo iPhone per consentirti di farla al coach a voce."}}, "pl": {"stringUnit": {"state": "translated", "value": "reNOOP transkrybuje pytanie na tym iPhonie, aby można było zadać je trenerowi na głos."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A reNOOP transcreve a sua pergunta neste iPhone para que a possa fazer ao treinador em voz alta."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "reNOOP 会在此 iPhone 上转写你的问题，以便你大声向教练提问。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "reNOOP 會在此 iPhone 上轉寫你的問題，以便你大聲向教練提問。"}}}}
  },
  "version" : "1.0"
}
