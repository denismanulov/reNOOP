[Unit]
Description=reNOOP friends server
After=network.target

[Service]
DynamicUser=yes
StateDirectory=renoop-friends
StateDirectoryMode=0700
UMask=0077
Environment=FRIENDS_DB=/var/lib/renoop-friends/friends.db
Environment=FRIENDS_BIND=127.0.0.1
Environment=FRIENDS_PORT=8787
# Optional overrides, e.g. FRIENDS_INVITE_CODE=...
EnvironmentFile=-/etc/renoop-friends.env
ExecStart=/usr/bin/python3 /opt/renoop-friends/server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
