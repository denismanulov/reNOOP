<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback the widget shows if Glance composition ever fails (NoopGlanceWidget.onCompositionError)
     instead of crashing the app process. The widget card's own colours (values/colors.xml). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_surface"
    android:textColor="@color/widget_on_surface_variant"
    android:textSize="12sp"
    android:text="@string/widget_error" />
